# Database connection string.
# On Vercel use Neon's pooled URL (host contains "-pooler"); the Neon integration sets it by default.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/your-database-name

# Optional: connections per app instance (default 5, minimum 3; Payload holds one permanently)
# DATABASE_POOL_MAX=5

# Postgres password used by docker-compose (must match DATABASE_URL)
POSTGRES_PASSWORD=postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
